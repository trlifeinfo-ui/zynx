                                    <script>

                                        /*
                                         * Gerçek QR kodu burada
                                         * göstermiyoruz.
                                         *
                                         * Gerçek QR sistemi araç
                                         * oluşturulduğunda:
                                         *
                                         * QR URL =
                                         * profile.html?qr=GÜVENLİ_TOKEN
                                         *
                                         * şeklinde oluşturulacak.
                                         */

                                        const qr =
                                            document.currentScript
                                                .parentElement;

                                        for (
                                            let i = 0;
                                            i < 441;
                                            i++
                                        ) {

                                            const cell =
                                                document.createElement(
                                                    "span"
                                                );

                                            /*
                                             * Görsel önizleme için
                                             * deterministik desen.
                                             */

                                            const x =
                                                i % 21;

                                            const y =
                                                Math.floor(i / 21);

                                            const finder =
                                                (
                                                    (x < 7 && y < 7) ||
                                                    (x > 13 && y < 7) ||
                                                    (x < 7 && y > 13)
                                                );

                                            const border =
                                                finder &&
                                                (
                                                    x === 0 ||
                                                    x === 6 ||
                                                    y === 0 ||
                                                    y === 6 ||
                                                    (
                                                        x >= 2 &&
                                                        x <= 4 &&
                                                        y >= 2 &&
                                                        y <= 4
                                                    )
                                                );

                                            const pattern =
                                                (
                                                    (
                                                        x * 17 +
                                                        y * 31 +
                                                        x * y
                                                    ) % 5
                                                ) < 2;

                                            if (
                                                border ||
                                                pattern
                                            ) {
                                                cell.style.background =
                                                    "#111";
                                            } else {
                                                cell.style.background =
                                                    "#fff";
                                            }

                                            qr.appendChild(cell);
                                        }

                                    </script>

