<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="theme-color"
        content="#080a0f"
    >

    <meta
        name="description"
        content="QRDrive — Araçlarınızı güvenli ve modern şekilde tanımlayın, QR kodunuzla kolayca paylaşın."
    >

    <title>QRDrive — Dijital Araç Kimliği</title>

    <!-- =========================================================
         QRDRIVE
         Ana Sayfa
         ========================================================= -->

    <style>

        /* =========================================================
           RESET
           ========================================================= */

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(
                    circle at 15% 10%,
                    rgba(62, 91, 255, 0.12),
                    transparent 32%
                ),
                radial-gradient(
                    circle at 85% 20%,
                    rgba(0, 210, 255, 0.08),
                    transparent 30%
                ),
                #080a0f;
            color: #f5f7fb;
            font-family:
                Inter,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;
            line-height: 1.5;
            overflow-x: hidden;
        }

        body.light {
            background:
                radial-gradient(
                    circle at 15% 10%,
                    rgba(62, 91, 255, 0.08),
                    transparent 32%
                ),
                #f5f7fb;
            color: #10131a;
        }

        button,
        input {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        /* =========================================================
           VARIABLES
           ========================================================= */

        :root {
            --primary: #5865f2;
            --primary-hover: #4752c4;

            --cyan: #19cfff;

            --bg: #080a0f;
            --panel: rgba(17, 20, 28, 0.76);
            --panel-solid: #11141c;

            --border: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(255, 255, 255, 0.15);

            --text: #f5f7fb;
            --muted: #9ba3b4;

            --success: #35d07f;

            --radius-sm: 12px;
            --radius-md: 18px;
            --radius-lg: 26px;

            --shadow:
                0 25px 80px rgba(0, 0, 0, 0.35);

            --container: 1180px;
        }

        body.light {
            --bg: #f5f7fb;
            --panel: rgba(255, 255, 255, 0.82);
            --panel-solid: #ffffff;

            --border: rgba(15, 20, 30, 0.08);
            --border-hover: rgba(15, 20, 30, 0.16);

            --text: #10131a;
            --muted: #626b7c;

            --shadow:
                0 25px 70px rgba(20, 30, 50, 0.12);
        }

        /* =========================================================
           UTILITIES
           ========================================================= */

        .container {
            width: min(
                calc(100% - 40px),
                var(--container)
            );

            margin-inline: auto;
        }

        .hidden {
            display: none !important;
        }

        .glass {
            background: var(--panel);
            border: 1px solid var(--border);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        /* =========================================================
           HEADER
           ========================================================= */

        .header {
            position: fixed;
            z-index: 1000;

            top: 0;
            left: 0;
            right: 0;

            height: 76px;

            display: flex;
            align-items: center;

            background:
                rgba(8, 10, 15, 0.72);

            border-bottom:
                1px solid var(--border);

            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);
        }

        body.light .header {
            background:
                rgba(245, 247, 251, 0.78);
        }

        .header-inner {
            width: min(
                calc(100% - 40px),
                var(--container)
            );

            margin-inline: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 24px;
        }

        /* =========================================================
           BRAND
           ========================================================= */

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 11px;

            font-weight: 850;
            font-size: 20px;
            letter-spacing: -0.5px;
        }

        .brand-icon {
            width: 40px;
            height: 40px;

            border-radius: 13px;

            display: grid;
            place-items: center;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--cyan)
                );

            box-shadow:
                0 10px 30px
                rgba(88, 101, 242, 0.3);
        }

        .brand-icon::before {
            content: "⌁";
            font-size: 27px;
            font-weight: 900;
            color: white;
            transform: rotate(-45deg);
        }

        .brand-text span {
            color: var(--primary);
        }

        /* =========================================================
           NAVIGATION
           ========================================================= */

        .nav {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav a {
            color: var(--muted);

            padding: 10px 13px;

            border-radius: 10px;

            font-size: 14px;
            font-weight: 650;

            transition:
                color .2s ease,
                background .2s ease;
        }

        .nav a:hover {
            color: var(--text);
            background:
                rgba(255, 255, 255, 0.05);
        }

        /* =========================================================
           HEADER ACTIONS
           ========================================================= */

        .header-actions {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .icon-button {
            width: 42px;
            height: 42px;

            border-radius: 12px;

            border: 1px solid var(--border);
            background: var(--panel);

            color: var(--text);

            display: grid;
            place-items: center;

            transition:
                transform .2s ease,
                border-color .2s ease,
                background .2s ease;
        }

        .icon-button:hover {
            transform: translateY(-2px);
            border-color: var(--border-hover);
        }

        .mobile-menu {
            display: none;
        }

        /* =========================================================
           BUTTONS
           ========================================================= */

        .btn {
            min-height: 44px;

            padding:
                0 18px;

            border-radius: 12px;

            border: 1px solid transparent;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            gap: 9px;

            font-size: 14px;
            font-weight: 750;

            transition:
                transform .2s ease,
                background .2s ease,
                border-color .2s ease,
                box-shadow .2s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-primary {
            color: white;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    #6975ff
                );

            box-shadow:
                0 12px 30px
                rgba(88, 101, 242, 0.22);
        }

        .btn-primary:hover {
            box-shadow:
                0 15px 35px
                rgba(88, 101, 242, 0.32);
        }

        .btn-secondary {
            color: var(--text);

            background:
                var(--panel);

            border-color:
                var(--border);
        }

        .btn-secondary:hover {
            border-color:
                var(--border-hover);
        }

        .btn-large {
            min-height: 54px;
            padding-inline: 24px;
            border-radius: 15px;
            font-size: 15px;
        }

        /* =========================================================
           HERO
           ========================================================= */

        .hero {
            position: relative;

            min-height: 850px;

            padding-top: 160px;
            padding-bottom: 100px;

            display: flex;
            align-items: center;
        }

        .hero::before {
            content: "";

            position: absolute;

            width: 500px;
            height: 500px;

            left: -250px;
            top: 100px;

            background:
                radial-gradient(
                    circle,
                    rgba(88, 101, 242, 0.16),
                    transparent 68%
                );

            pointer-events: none;
        }

        .hero-grid {
            display: grid;

            grid-template-columns:
                1.05fr
                .95fr;

            gap: 70px;

            align-items: center;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 8px 12px;

            margin-bottom: 24px;

            border:
                1px solid
                rgba(88, 101, 242, 0.24);

            border-radius: 999px;

            background:
                rgba(88, 101, 242, 0.08);

            color: #aeb5ff;

            font-size: 12px;
            font-weight: 750;

            letter-spacing: .3px;
        }

        .eyebrow-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background:
                var(--success);

            box-shadow:
                0 0 12px
                rgba(53, 208, 127, 0.7);
        }

        .hero h1 {
            max-width: 700px;

            font-size:
                clamp(
                    48px,
                    6vw,
                    78px
                );

            line-height: .98;

            letter-spacing:
                -4px;

            margin-bottom: 26px;
        }

        .hero h1 .gradient {
            background:
                linear-gradient(
                    110deg,
                    #ffffff 0%,
                    #9ca6ff 48%,
                    #19cfff 100%
                );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;
        }

        body.light .hero h1 .gradient {
            background:
                linear-gradient(
                    110deg,
                    #11131a,
                    #5865f2,
                    #0797bd
                );

            -webkit-background-clip: text;
            background-clip: text;

            color: transparent;
        }

        .hero-description {
            max-width: 600px;

            color: var(--muted);

            font-size: 17px;

            line-height: 1.75;

            margin-bottom: 34px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;

            gap: 12px;

            margin-bottom: 36px;
        }

        .hero-trust {
            display: flex;
            align-items: center;
            gap: 14px;

            color: var(--muted);

            font-size: 13px;
        }

        .trust-icon {
            width: 30px;
            height: 30px;

            border-radius: 9px;

            display: grid;
            place-items: center;

            background:
                rgba(53, 208, 127, 0.1);

            color:
                var(--success);
        }

        /* =========================================================
           QR PREVIEW
           ========================================================= */

        .hero-visual {
            position: relative;

            min-height: 570px;

            display: grid;
            place-items: center;
        }

        .glow {
            position: absolute;

            width: 430px;
            height: 430px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(88, 101, 242, 0.25),
                    transparent 68%
                );

            filter: blur(15px);
        }

        .vehicle-card {
            position: relative;
            z-index: 2;

            width: min(
                100%,
                410px
            );

            padding: 20px;

            border:
                1px solid
                rgba(255, 255, 255, 0.12);

            border-radius: 28px;

            background:
                linear-gradient(
                    145deg,
                    rgba(28, 32, 43, 0.96),
                    rgba(12, 15, 21, 0.96)
                );

            box-shadow:
                0 40px 100px
                rgba(0, 0, 0, .55);

            transform:
                perspective(1200px)
                rotateY(-7deg)
                rotateX(3deg);

            transition:
                transform .5s ease;
        }

        .vehicle-card:hover {
            transform:
                perspective(1200px)
                rotateY(0)
                rotateX(0)
                translateY(-8px);
        }

        .vehicle-card-top {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin-bottom: 20px;
        }

        .mini-brand {
            display: flex;
            align-items: center;
            gap: 8px;

            font-size: 13px;
            font-weight: 800;
        }

        .mini-logo {
            width: 27px;
            height: 27px;

            border-radius: 8px;

            display: grid;
            place-items: center;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--cyan)
                );

            font-size: 13px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;

            padding: 6px 9px;

            border-radius: 999px;

            background:
                rgba(53, 208, 127, .09);

            color:
                var(--success);

            font-size: 10px;
            font-weight: 800;
        }

        .status::before {
            content: "";

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                var(--success);
        }

        .qr-area {
            padding: 26px;

            display: grid;
            place-items: center;

            border-radius: 22px;

            background:
                #ffffff;

            margin-bottom: 20px;
        }

        .fake-qr {
            width: 210px;
            height: 210px;

            display: grid;

            grid-template-columns:
                repeat(21, 1fr);

            grid-template-rows:
                repeat(21, 1fr);

            gap: 2px;

            background: white;
        }

        .fake-qr span {
            background: #111;
        }

        .fake-qr span:nth-child(3n) {
            background: white;
        }

        .fake-qr span:nth-child(7n) {
            background: #111;
        }

        .vehicle-info {
            display: grid;

            grid-template-columns:
                1fr
                auto;

            gap: 15px;
        }

        .vehicle-name {
            font-size: 21px;
            font-weight: 850;
        }

        .vehicle-meta {
            color: #929aaa;
            font-size: 12px;
            margin-top: 3px;
        }

        .scan-text {
            text-align: right;

            color: #9ba3b4;

            font-size: 10px;
            line-height: 1.4;
        }

        /* =========================================================
           FLOATING INFO
           ========================================================= */

        .floating-card {
            position: absolute;
            z-index: 3;

            display: flex;
            align-items: center;
            gap: 12px;

            padding: 12px 15px;

            border:
                1px solid
                rgba(255,255,255,.1);

            border-radius: 15px;

            background:
                rgba(17,20,28,.82);

            box-shadow:
                0 20px 50px
                rgba(0,0,0,.35);

            backdrop-filter: blur(18px);
        }

        .floating-card.one {
            top: 80px;
            right: 0;
        }

        .floating-card.two {
            left: 0;
            bottom: 80px;
        }

        .floating-icon {
            width: 36px;
            height: 36px;

            display: grid;
            place-items: center;

            border-radius: 11px;

            background:
                rgba(88,101,242,.13);

            color:
                #aab1ff;
        }

        .floating-title {
            font-size: 12px;
            font-weight: 800;
        }

        .floating-subtitle {
            color: #7f8798;
            font-size: 10px;
        }

        /* =========================================================
           SECTION
           ========================================================= */

        .section {
            padding: 110px 0;
        }

        .section-heading {
            max-width: 650px;

            margin-bottom: 50px;
        }

        .section-label {
            color: var(--primary);

            font-size: 12px;
            font-weight: 850;

            text-transform: uppercase;

            letter-spacing: 1.5px;

            margin-bottom: 13px;
        }

        .section-heading h2 {
            font-size:
                clamp(
                    34px,
                    4vw,
                    52px
                );

            letter-spacing:
                -2px;

            line-height: 1.05;

            margin-bottom: 15px;
        }

        .section-heading p {
            color: var(--muted);
            line-height: 1.75;
        }

        /* =========================================================
           FEATURE CARDS
           ========================================================= */

        .feature-grid {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 16px;
        }

        .feature-card {
            padding: 28px;

            border:
                1px solid
                var(--border);

            border-radius:
                var(--radius-md);

            background:
                var(--panel);

            transition:
                transform .25s ease,
                border-color .25s ease,
                box-shadow .25s ease;
        }

        .feature-card:hover {
            transform:
                translateY(-6px);

            border-color:
                var(--border-hover);

            box-shadow:
                var(--shadow);
        }

        .feature-icon {
            width: 48px;
            height: 48px;

            display: grid;
            place-items: center;

            border-radius: 14px;

            background:
                rgba(88,101,242,.1);

            color:
                #a9b0ff;

            font-size: 20px;

            margin-bottom: 23px;
        }

        .feature-card h3 {
            font-size: 18px;
            margin-bottom: 9px;
        }

        .feature-card p {
            color: var(--muted);

            font-size: 14px;

            line-height: 1.7;
        }

        /* =========================================================
           HOW IT WORKS
           ========================================================= */

        .steps {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 18px;
        }

        .step {
            position: relative;

            padding: 30px;

            border:
                1px solid
                var(--border);

            border-radius:
                var(--radius-md);

            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.035),
                    rgba(255,255,255,.015)
                );
        }

        .step-number {
            display: inline-flex;

            width: 38px;
            height: 38px;

            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background:
                rgba(88,101,242,.13);

            color:
                #aeb4ff;

            font-weight: 850;

            margin-bottom: 22px;
        }

        .step h3 {
            margin-bottom: 9px;
        }

        .step p {
            color: var(--muted);

            font-size: 14px;
            line-height: 1.7;
        }

        /* =========================================================
           PRIVACY SECTION
           ========================================================= */

        .privacy-box {
            display: grid;

            grid-template-columns:
                .9fr
                1.1fr;

            gap: 60px;

            align-items: center;

            padding: 45px;

            border:
                1px solid
                var(--border);

            border-radius:
                30px;

            background:
                linear-gradient(
                    145deg,
                    rgba(88,101,242,.09),
                    rgba(25,207,255,.025)
                );
        }

        .privacy-copy h2 {
            font-size: 38px;
            line-height: 1.1;

            letter-spacing: -1.5px;

            margin-bottom: 15px;
        }

        .privacy-copy p {
            color: var(--muted);
            line-height: 1.75;
        }

        .privacy-options {
            display: grid;
            gap: 10px;
        }

        .privacy-option {
            display: flex;
            align-items: center;
            gap: 15px;

            padding: 15px 17px;

            border:
                1px solid
                var(--border);

            border-radius: 14px;

            background:
                rgba(0,0,0,.12);
        }

        .privacy-option-icon {
            width: 40px;
            height: 40px;

            display: grid;
            place-items: center;

            border-radius: 11px;

            background:
                rgba(255,255,255,.05);
        }

        .privacy-option strong {
            display: block;
            font-size: 13px;
        }

        .privacy-option span {
            display: block;

            color: var(--muted);

            font-size: 11px;

            margin-top: 2px;
        }

        /* =========================================================
           CTA
           ========================================================= */

        .cta {
            padding: 100px 0;
        }

        .cta-box {
            position: relative;

            overflow: hidden;

            padding:
                70px 40px;

            text-align: center;

            border:
                1px solid
                rgba(88,101,242,.2);

            border-radius: 30px;

            background:
                radial-gradient(
                    circle at center,
                    rgba(88,101,242,.16),
                    transparent 65%
                ),
                rgba(17,20,28,.65);
        }

        .cta-box h2 {
            font-size:
                clamp(
                    34px,
                    4vw,
                    52px
                );

            letter-spacing: -2px;

            margin-bottom: 15px;
        }

        .cta-box p {
            max-width: 580px;

            margin:
                0 auto 28px;

            color: var(--muted);

            line-height: 1.7;
        }

        /* =========================================================
           FOOTER
           ========================================================= */

        footer {
            border-top:
                1px solid
                var(--border);

            padding:
                35px 0;
        }

        .footer-inner {
            display: flex;

            align-items: center;
            justify-content: space-between;

            gap: 20px;
        }

        .footer-copy {
            color: var(--muted);
            font-size: 12px;
        }

        .footer-links {
            display: flex;
            gap: 18px;
        }

        .footer-links a {
            color: var(--muted);
            font-size: 12px;
        }

        .footer-links a:hover {
            color: var(--text);
        }

        /* =========================================================
           MOBILE
           ========================================================= */

        @media (max-width: 1000px) {

            .nav {
                display: none;
            }

            .mobile-menu {
                display: grid;
            }

            .hero-grid {
                grid-template-columns: 1fr;
            }

            .hero {
                padding-top: 130px;
            }

            .hero-content {
                text-align: center;
            }

            .hero-description {
                margin-inline: auto;
            }

            .hero-actions {
                justify-content: center;
            }

            .hero-trust {
                justify-content: center;
            }

            .hero-visual {
                min-height: 520px;
            }

            .feature-grid,
            .steps {
                grid-template-columns: 1fr;
            }

            .privacy-box {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 620px) {

            .container {
                width:
                    min(
                        calc(100% - 28px),
                        var(--container)
                    );
            }

            .header {
                height: 68px;
            }

            .header-inner {
                width:
                    calc(100% - 28px);
            }

            .brand {
                font-size: 17px;
            }

            .brand-icon {
                width: 36px;
                height: 36px;
            }

            .header-actions .btn-secondary {
                display: none;
            }

            .hero {
                min-height: auto;
                padding-top: 120px;
                padding-bottom: 70px;
            }

            .hero h1 {
                font-size: 48px;
                letter-spacing: -2.8px;
            }

            .hero-description {
                font-size: 15px;
            }

            .hero-visual {
                min-height: 440px;
            }

            .vehicle-card {
                transform: none;
            }

            .vehicle-card:hover {
                transform:
                    translateY(-5px);
            }

            .fake-qr {
                width: 165px;
                height: 165px;
            }

            .qr-area {
                padding: 20px;
            }

            .floating-card {
                transform:
                    scale(.82);
            }

            .floating-card.one {
                right: -25px;
                top: 20px;
            }

            .floating-card.two {
                left: -25px;
